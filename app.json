{
  "expo": {
    "name": "Produccion",
    "slug": "app-tablet2",
    "scheme": "app-tablet2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/kore_icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/kore_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1923"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/kore_icon.png",
        "backgroundColor": "#0F1923"
      },
      "package": "com.kayxo49.apptablet2",
      "permissions": ["INTERNET", "ACCESS_NETWORK_STATE"]
    },
    "web": {
      "favicon": "./assets/kore_icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "326e66c6-ff27-4e22-834b-da45cc93cb97"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/326e66c6-ff27-4e22-834b-da45cc93cb97"
    }
  }
}